# Public canonical URL of the production site (no trailing slash). Required for
# canonical tags, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example-amala-domain.in

# Enquiry delivery via Resend (https://resend.com). The form will return an
# error — never a fake success — until these are configured.
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Amala Biofuels Website <web@yourdomain.in>"
ENQUIRY_FROM_EMAIL=
# Comma-separated list of inboxes that should receive enquiries
ENQUIRY_TO_EMAIL=

# Optional: forward every successful enquiry as JSON to a CRM / automation
# webhook (HubSpot, Zoho, Make, Zapier...). Sent in addition to the email.
ENQUIRY_WEBHOOK_URL=

# Set to "true" to show "draft copy" review markers (e.g. on a staging deploy
# for client sign-off). Off by default everywhere, including local dev.
NEXT_PUBLIC_SHOW_CONTENT_FLAGS=false
